#!/usr/bin/env nextflow
import nextflow.util.SysHelper

// External config files import. DO NOT MODIFY THESE LINES!
includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

// EXECUTION SETTINGS AND GLOBAL DEFAULTS
params {
    dataset_id = ''

    // `portion_id` is added to the suffix of the output FASTQ file names.
    portion_id = '0'

    output_dir = "/absolute/path/to/output_directory"
    reference_fasta = "/absolute/path/to/reference/fasta"

    // Processing options
    filter_qc_failed_reads = false
    split_unmapped_reads_to_separate_file = false

    save_intermediate_files = false

    // Base resource allocation updater
    // See README for adding parameters to update the base resource allocations

}

// Setup the pipeline config. DO NOT REMOVE THIS LINE!
methods.setup()
